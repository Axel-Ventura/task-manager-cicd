{
  "name": "tareaxd",
  "version": "1.0.0",
  "description": "API REST para la gestión de tareas, orientada a demostrar un pipeline CI/CD.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --runInBand",
    "release:prepare": "node scripts/setup-release.js",
    "release:test": "node scripts/test-release.js",
    "release:build": "node scripts/build-release.js",
    "release": "npm run release:prepare && npm run release:test && npm run release:build",
    "deploy": "node scripts/deploy.js",
    "deploy:verify": "node scripts/verify-deployment.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
